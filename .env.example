# Copy this file to `backend/.env` and fill in the values:
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Lifetime for signed attachment URLs, seconds
ATTACHMENT_SIGNED_URL_TTL=3600

# --- Logging & tracing (see README section 11) ------------------------------
# Log format: console (human) | json (one JSON object per line)
LOG_FORMAT=console
# Floor level for app logs: debug | info | warning | error
LOG_LEVEL=info
# false removes ALL tracing instrumentation and export (zero overhead)
TRACE_ENABLED=true
# Service name as it appears in the trace viewer AND the service_name field
# in persisted log records
OTEL_SERVICE_NAME=hrdesk-api
# Where spans are exported (Jaeger all-in-one OTLP/HTTP port locally);
# /v1/traces is appended automatically when missing.
# Jaeger all-in-one: docker run --rm -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Collapse repeated exporter-failure log lines ("connection refused …") to at
# most one raw line per window (seconds) plus a backend summary. 0 disables.
OTEL_EXPORT_ERROR_LOG_WINDOW_SECONDS=300

# --- Persistent log files (rotating JSON; see README section 11) ------------
# daily rotation at midnight; retention deletes older files
LOG_TO_FILE=true
LOG_FILE_RETENTION_DAYS=14
# Optional override — default is backend/logs/app.log (gitignored)
# LOG_FILE_PATH=/var/log/hrdesk/app.log
