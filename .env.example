# PostgreSQL URL (local, managed, or self-hosted).  <== PASTE YOUR CREDENTIALS HERE
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Tip: append ?connect_timeout=10 to fail fast on a dead host.
DATABASE_URL=

# Local fixtures use hrdesk/change-me; replace with the real ones you were given.
# Example once you have credentials:
#   DATABASE_URL=postgresql://myuser:mypassword@db.example.com:5432/hrdesk?connect_timeout=10

# Secret used to sign attachment download URLs. Generate with: openssl rand -hex 32
# Keep this value identical across app workers and restarts.  <== PASTE YOUR SIGNING KEY HERE
ATTACHMENT_SIGNING_KEY=

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Lifetime for signed attachment URLs, seconds
ATTACHMENT_SIGNED_URL_TTL=3600

# PostgreSQL connection pool limits
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=5

# --- Logging & tracing (see README section 11) ------------------------------
LOG_FORMAT=console
LOG_LEVEL=info
TRACE_ENABLED=true
OTEL_SERVICE_NAME=hrdesk-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Collapse repeated exporter-failure log lines ("connection refused …") to at
# most one raw line per window (seconds) plus a backend summary. 0 disables.
OTEL_EXPORT_ERROR_LOG_WINDOW_SECONDS=300

# --- Persistent log files (rotating JSON) -----------------------------------
LOG_TO_FILE=true
LOG_FILE_RETENTION_DAYS=14
# Optional override — default is backend/logs/app.log (gitignored)
# LOG_FILE_PATH=/var/log/hrdesk/app.log

# --- HR assistant (RAG over the knowledge base, app/rag/) -------------------
# Create a free token at https://huggingface.co/settings/tokens (type "Inference"
# or "Fine-grained" with inference enabled) and paste it here. LEFT EMPTY, the
# assistant answers with a "not configured" message, KB search works unchanged,
# and seeding skips the paragraph-chunk embedding step.
RAG_HF_TOKEN=
# Chat model (OpenAI-compatible HF router). If you get 404/403, pick any model
# whose page shows an "Inference Providers" widget on huggingface.co:
# https://huggingface.co/models?inference_provider=all&sort=trending
RAG_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
RAG_CHAT_URL=https://router.huggingface.co/v1/chat/completions
# Embedding model for paragraph similarity (384-dim MiniLM default).
RAG_EMBED_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
# How many cited paragraph chunks are handed to the chat model per question.
RAG_TOP_K=4

