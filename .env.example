# PostgreSQL URL (local, managed, or self-hosted).  <== PASTE YOUR CREDENTIALS HERE
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Tip: append ?connect_timeout=10 to fail fast on a dead host.
DATABASE_URL=

# Local fixtures use hrdesk/change-me; replace with the real ones you were given.
# Example once you have credentials:
#   DATABASE_URL=postgresql://myuser:mypassword@db.example.com:5432/hrdesk?connect_timeout=10

# Secret used to sign attachment download URLs. Generate with: openssl rand -hex 32
# Keep this value identical across app workers and restarts.  <== PASTE YOUR SIGNING KEY HERE
ATTACHMENT_SIGNING_KEY=

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Lifetime for signed attachment URLs, seconds
ATTACHMENT_SIGNED_URL_TTL=3600

# PostgreSQL connection pool limits
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=5

# --- Logging & tracing (see README section 11) ------------------------------
LOG_FORMAT=console
LOG_LEVEL=info
TRACE_ENABLED=true
OTEL_SERVICE_NAME=hrdesk-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Collapse repeated exporter-failure log lines ("connection refused …") to at
# most one raw line per window (seconds) plus a backend summary. 0 disables.
OTEL_EXPORT_ERROR_LOG_WINDOW_SECONDS=300

# --- Persistent log files (rotating JSON) -----------------------------------
LOG_TO_FILE=true
LOG_FILE_RETENTION_DAYS=14
# Optional override — default is backend/logs/app.log (gitignored)
# LOG_FILE_PATH=/var/log/hrdesk/app.log

# --- HR assistant (RAG over the knowledge base, app/rag/) -------------------
# Create a Google Gemini API key at https://aistudio.google.com/apikey and
# paste it here (a bare GEMINI_API_KEY= line in the environment also works).
# LEFT EMPTY, the assistant answers with a "not configured" message, KB search
# works unchanged, and seeding skips the paragraph-chunk embedding step.
RAG_GEMINI_API_KEY=
# Chat model (Gemini's OpenAI-compatible endpoint). Pick any current Gemini
# chat model: https://ai.google.dev/gemini-api/docs/models
RAG_CHAT_MODEL=gemini-flash-lite-latest
# Reasoning budget for the chat model (OpenAI-compat `reasoning_effort`).
# Lite models have no thinking phase — leave EMPTY ("RAG_CHAT_REASONING=") to
# omit the parameter. Thinking models (e.g. gemini-3.8-flash) can set "low"
# (guardrails) or "none" (fastest); clear the value to use model defaults.
RAG_CHAT_REASONING=
RAG_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Embedding model for paragraph similarity (Gemini embeddings). NOTE:
# text-embedding-004 is retired on this endpoint (answers 404) — use
# gemini-embedding-001 or text-embedding-005.
RAG_EMBED_MODEL=gemini-embedding-001
RAG_EMBED_URL=https://generativelanguage.googleapis.com/v1beta/openai/embeddings
# How many cited paragraph chunks are handed to the chat model per question.
RAG_TOP_K=4
# Provider call budgets + bounded transparent retry (both provider clients).
# Transient failures ONLY: read/connect timeouts and 5xx/429 get retried;
# auth/model-name 4xx never are. Attempts x backoff bounds the added wait
# (the defaults are already sensible; uncomment to override).
# RAG_CHAT_TIMEOUT_S=120   # whole-response read budget (thinking models are slow to start)
# RAG_EMBED_TIMEOUT_S=30
# RAG_RETRY_ATTEMPTS=2
# RAG_RETRY_BACKOFF_S=2.0

