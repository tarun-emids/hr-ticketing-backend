# PostgreSQL URL (local, managed, or self-hosted).
DATABASE_URL=postgresql://hrdesk:change-me@localhost:5432/hrdesk

# Generate a stable secret with: openssl rand -hex 32
# Keep this value identical across app workers and restarts.
ATTACHMENT_SIGNING_KEY=

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Lifetime for signed attachment URLs, seconds
ATTACHMENT_SIGNED_URL_TTL=3600

# PostgreSQL connection pool limits
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=5

# --- Logging & tracing (see README section 11) ------------------------------
LOG_FORMAT=console
LOG_LEVEL=info
TRACE_ENABLED=true
OTEL_SERVICE_NAME=hrdesk-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Persistent log files (rotating JSON) -----------------------------------
LOG_TO_FILE=true
LOG_FILE_RETENTION_DAYS=14
# Optional override — default is backend/logs/app.log (gitignored)
# LOG_FILE_PATH=/var/log/hrdesk/app.log
